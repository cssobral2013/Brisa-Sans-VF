  sub eukrcyr acutecomb by eukrcyr_acutecomb;
  sub icyr acutecomb by icyr_acutecomb;
  sub iecyr acutecomb by iecyr_acutecomb;
  sub iocyr acutecomb by iocyr_acutecomb;
  sub iukrcyr acutecomb by iukrcyr_acutecomb;
  sub macroncomb acutecomb by macroncomb_acutecomb;
  sub macroncomb tildecomb by macroncomb_tildecomb;
  sub ocyr acutecomb by ocyr_acutecomb;
  sub ringcomb acutecomb by ringcomb_acutecomb;
  sub semisoftcyr acutecomb by semisoftcyr_acutecomb;
