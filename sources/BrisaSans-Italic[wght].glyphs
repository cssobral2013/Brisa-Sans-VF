},
{
code = "# GSUB feature: Localized Forms
# Lookups: 2

  script latn; # Latin
    language AZE ; # Azerbaijani

    lookup locl_latn {
    # GSUB lookup 29, type 11 (Single)
      sub i by i.locl;
    } locl_latn;


    language GAG ; # Gagauz
    lookup locl_latn;

    language TRK ; # Turkish
    lookup locl_latn;

    language TAT ; # Tatar
    lookup locl_latn;

    language CRT ; # Crimean Tatar
    lookup locl_latn;

    language KAZ ; # Kazakh
    lookup locl_latn;


  script cyrl; # Cyrillic
    language BGR ;
    sub @loclBGR by @loclBGR2;


    language SRB ; # Serbian

    lookup locl_cyrlSRB_cyrlMKD {
    # GSUB lookup 30, type 11 (Single)
      sub becyr by becyr.locl;
