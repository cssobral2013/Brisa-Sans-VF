  sub i ogonekcomb by iogonek;
  sub o horncomb by ohorn;
  sub s cedillacomb by scedilla;
  sub t cedillacomb by tcedilla;
  sub u ogonekcomb by uogonek;
  sub u horncomb by uhorn;
  sub dieresis acutecomb by dieresistonos;

  lookup liga_2 {
  # GSUB lookup 63, type 11 (Single)
    sub zero.superior by zero.inferior;
    sub onesuperior by one.inferior;
    sub twosuperior by two.inferior;
    sub threesuperior by three.inferior;
    sub four.superior by four.inferior;
    sub five.superior by five.inferior;
    sub six.superior by six.inferior;
    sub seven.superior by seven.inferior;
    sub eight.superior by eight.inferior;
    sub nine.superior by nine.inferior;
  } liga_2;

  lookup liga_3;

  lookup liga_4;

  script latn; # Latin
    language AZE  exclude_dflt; # Azerbaijani
    lookup liga_2;

    language GAG  exclude_dflt; # Gagauz
    lookup liga_2;

    language TRK  exclude_dflt; # Turkish
    lookup liga_2;

    language TAT  exclude_dflt; # Tatar
    lookup liga_2;

    language CRT  exclude_dflt; # Crimean Tatar
